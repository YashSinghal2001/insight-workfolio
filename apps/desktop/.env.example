# Public build-time settings (embedded in the app bundle). Never put secrets here.
# Dev and debug builds: http://localhost / 127.0.0.1 / [::1] or any https:// URL (default http://localhost:4000).
# Release builds: do not set this here; run `WORKFOLIO_API_URL=https://api.example.com pnpm package`,
# which also sets the CSP connect-src to that origin (see docs/deployment.md "Desktop API URL").
VITE_API_URL=http://localhost:4000
