# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
# Dashboard dev server, Tauri dev server, Tauri production webview (macOS / Windows).
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost

# Local SQLite file for development (created automatically).
# For Turso: DATABASE_URL=libsql://<database>-<org>.turso.io and set DATABASE_AUTH_TOKEN.
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# HMAC key for 15-minute access tokens. REQUIRED in production (min 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional in development: an ephemeral key is generated at boot (sessions survive via refresh).
JWT_SECRET=

# Dashboard origin, used only by the admin bootstrap CLI to print the one-time setup link.
DASHBOARD_URL=http://localhost:3000

# Screenshot storage (docs/onedrive.md). "local" = DEVELOPMENT ONLY (files under SCREENSHOT_LOCAL_DIR);
# production requires "graph" with a dedicated SharePoint library and Sites.Selected access.
SCREENSHOT_STORAGE=local
SCREENSHOT_LOCAL_DIR=./data/screenshots
# Server-side only; never shipped to desktops. Leave empty unless SCREENSHOT_STORAGE=graph.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Exactly one credential: a client secret, or (preferred) a certificate key file + its SHA-1 thumbprint.
GRAPH_CLIENT_SECRET=
GRAPH_CERT_KEY_PATH=
GRAPH_CERT_THUMBPRINT=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
# false = retention deletes go to the SharePoint recycle bin (recoverable for up to 93 days).
GRAPH_PERMANENT_DELETE=false
GRAPH_FOLDER=Workfolio Screenshots
