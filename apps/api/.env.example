# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated browser origins allowed to call the API.
# Dashboard dev server, Tauri dev server, Tauri production webview (macOS / Windows).
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost,http://tauri.localhost

# Which proxies to trust for the client address (rate limits are keyed by it). Default "loopback";
# behind Render's proxy use 1. Accepts a hop count 0-10 or a comma list of IPs/CIDRs; "true" is refused.
TRUST_PROXY=loopback
# Requests per minute per signed-in session (with a 10x per-IP ceiling). Empty = default:
# 600 in production, off in development/test. 0 turns both limits off.
API_RATE_LIMIT_PER_MINUTE=

# Local SQLite file for development (created automatically). With a file: (or :memory:) URL the API
# applies pending migrations at boot.
# A remote URL (libsql:// or https://) disables migrate-at-boot: the API only verifies the schema and
# refuses to start while a migration is pending. Migrate hosted databases with `db:migrate` (dry-run
# first, with approval; docs/database-operations.md).
# NEVER put staging or production credentials in apps/api/.env. Keep staging env files OUTSIDE the
# repository (mode 600) and pass them explicitly (verify:turso <file>, node --env-file=<file>).
# For Turso: DATABASE_URL=libsql://<database>-<org>.turso.io and set DATABASE_AUTH_TOKEN.
# (wss:// is refused in production: Turso staging rejects WebSocket connections.)
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# HMAC key for 15-minute access tokens. REQUIRED in production (min 32 chars), e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Optional in development: an ephemeral key is generated at boot (sessions survive via refresh).
JWT_SECRET=

# Dashboard origin, used only by the admin bootstrap CLI to print the one-time setup link.
DASHBOARD_URL=http://localhost:3000

# Screenshot and timelapse storage (docs/onedrive.md). "local" = DEVELOPMENT ONLY (files under SCREENSHOT_LOCAL_DIR);
# production: "onedrive" (the IT storage account's OneDrive, delegated Files.ReadWrite) or "graph" (SharePoint, Sites.Selected).
SCREENSHOT_STORAGE=local
SCREENSHOT_LOCAL_DIR=./data/screenshots
# Server-side only; never shipped to desktops. Leave empty unless SCREENSHOT_STORAGE=graph.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Exactly one credential: a client secret, or (preferred) a certificate key file + its SHA-1 thumbprint.
GRAPH_CLIENT_SECRET=
GRAPH_CERT_KEY_PATH=
GRAPH_CERT_THUMBPRINT=
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
# false = retention deletes go to the SharePoint recycle bin (recoverable for up to 93 days).
GRAPH_PERMANENT_DELETE=false
GRAPH_FOLDER=Workfolio Screenshots

# Microsoft OneDrive of the dedicated IT storage account (SCREENSHOT_STORAGE=onedrive). Set all seven (or none).
# Entra app registration: Web platform, redirect URI below, delegated Files.ReadWrite + offline_access only.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Must equal the redirect URI registered in Entra: <API origin>/api/v1/storage/onedrive/oauth/callback
ONEDRIVE_REDIRECT_URI=
# Absolute path on a persistent disk, outside the repository: the encrypted connection (refresh token).
ONEDRIVE_TOKEN_FILE=
# openssl rand -base64 32 (encrypts ONEDRIVE_TOKEN_FILE; changing it means reconnecting).
ONEDRIVE_TOKEN_KEY=
# The only account allowed to connect.
ONEDRIVE_ACCOUNT_EMAIL=
ONEDRIVE_ROOT_FOLDER=InsightWorkfolio

# Google Drive TESTING POC (GOOGLE-DRIVE-STORAGE-SETUP.md): OAuth "Web application" client, scope drive.file only.
# Set all five (or none). Separate client + token file per environment; the secret stays server-side.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must equal the URI registered in Google Cloud: <API origin>/api/v1/storage/google-drive/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Absolute path outside the repository; the connect flow writes the refresh token here (0600).
GOOGLE_DRIVE_TOKEN_FILE=
# The only Google account allowed to connect.
GOOGLE_DRIVE_ACCOUNT_EMAIL=
# false = deletes go to the Drive trash (recoverable for 30 days).
GOOGLE_DRIVE_PERMANENT_DELETE=false

# Email reports (docs/email-reports.md). No real email provider is integrated yet.
# none = reports are generated and recorded, nothing is emailed; mock = in-memory, development only.
REPORT_MAIL_PROVIDER=none
# Seconds between scheduler checks for due reports and retries; 0 = off.
REPORT_SCHEDULER_SECONDS=300

# Website tracking (docs/website-usage.md). In production, collection is blocked until the operator sets
# this after HR/Legal approval; an admin turning the policy on is not that approval.
WEBSITE_TRACKING_APPROVED=false
# Scheduled website-retention purge runs only when true (manual purge in the dashboard always needs confirmation).
WEBSITE_RETENTION_APPROVED=false
