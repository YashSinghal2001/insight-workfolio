{
  "name": "@workfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "admin:create": "node dist/cli/create-admin.js",
    "db:migrate": "node dist/cli/migrate.js",
    "verify:graph": "node scripts/verify-graph.mjs",
    "verify:onedrive": "node scripts/verify-onedrive.mjs",
    "verify:google-drive": "node scripts/verify-google-drive.mjs",
    "verify:turso": "node scripts/verify-turso.mjs",
    "db:dump": "node scripts/db-dump.mjs",
    "staging:suite": "node scripts/staging-suite.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "nest build && node --test"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@workfolio/database": "workspace:*",
    "@workfolio/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "pino-pretty": "13.2.0"
  }
}
