{
  "name": "@workfolio/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --import ./test/register-tsx.mjs --test \"src/**/*.test.{ts,mjs}\" \"test/**/*.test.{ts,tsx,mjs}\"",
    "test": "pnpm run test:unit && NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://localhost:4000} next build && node scripts/smoke.mjs",
    "verify:gallery": "node scripts/verify-gallery.mjs",
    "verify:timelapse": "node scripts/verify-timelapse.mjs",
    "verify:masks": "node scripts/verify-masks.mjs",
    "verify:reports": "node scripts/verify-reports.mjs",
    "verify:my-panel": "node scripts/verify-my-panel.mjs",
    "verify:web-app": "node scripts/verify-web-app.mjs",
    "verify:web-product": "node scripts/verify-web-product.mjs",
    "verify:setup-password": "node scripts/verify-setup-password.mjs",
    "verify:invitations": "node scripts/verify-invitations.mjs",
    "verify:wave2": "node scripts/verify-wave2.mjs",
    "verify:parity": "node scripts/verify-parity.mjs"
  },
  "dependencies": {
    "@workfolio/shared": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
