# Optional settings for workfolio-backup.service (deploy/scripts/backup-db.sh).
# Copy to /etc/workfolio/backup.env, owner root:workfolio, mode 0640.

# Days of nightly backups kept in /var/backups/workfolio (each is a full copy; ~size of the database, gzip'd).
BACKUP_KEEP_DAYS=30

# Encrypt each backup with gpg (AES-256, symmetric) using the passphrase in this file (0600 workfolio).
# Required before any upload off the VPS: the database holds personal data. Keep the passphrase somewhere
# else too (password manager): without it the backups cannot be read.
#BACKUP_GPG_PASSPHRASE_FILE=/var/lib/workfolio/secrets/backup-passphrase

# Off-site copy: a command run as `bash -c "$BACKUP_UPLOAD_CMD" upload <file>` after a successful backup
# (the file path is $1). backup-db.sh refuses to run it unless BACKUP_GPG_PASSPHRASE_FILE is set: only
# encrypted backups leave the VPS. A failing upload fails the backup run (journal, monitor.sh alert).
#
# Selected destination: the company OneDrive already connected for screenshots, in its own folder
# <ONEDRIVE_ROOT_FOLDER>/<ONEDRIVE_BACKUP_FOLDER> (api.env; default InsightWorkfolio/db-backups). The uploader
# is the API's own CLI, reusing the API's OneDrive connection: no extra credential. It refuses anything that
# is not a gpg-encrypted backup. `check` and `list` test the connection without uploading.
# Put the WHOLE value in single quotes: systemd removes unquoted inner double quotes from EnvironmentFile values.
#BACKUP_UPLOAD_CMD='cd /opt/workfolio/current/apps/api && /usr/bin/node --env-file=/etc/workfolio/api.env dist/cli/backup-upload.js upload "$1"'
# Alternative (another provider through rclone, configured separately as the workfolio user):
#BACKUP_UPLOAD_CMD='rclone copy "$1" offsite:workfolio-db-backups/'

# Warn in the journal when the backup or database filesystem is fuller than this (percent).
DISK_WARN_PERCENT=80
