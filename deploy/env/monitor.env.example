# Settings for workfolio-monitor.timer (deploy/scripts/monitor.sh, every 5 minutes as workfolio).
# Copy to /etc/workfolio/monitor.env, owner root:workfolio, mode 0640. Everything is optional: without an
# alert destination the monitor only logs (journalctl -t workfolio-monitor) and keeps its state file.

# Where alerts go. Channels are independent: each configured one is tried, a failure of one never stops
# another. Alerts are sent when the verdict CHANGES (OK -> WARN/FAIL, back to OK) and repeated every
# ALERT_REPEAT_MINUTES while a FAIL persists; never on every run. Every URL below is a secret: this file stays
# 0640 root:workfolio and never goes into Git. Test delivery without touching the monitor state:
#   systemd-run --wait --pipe -p User=workfolio -p EnvironmentFile=/etc/workfolio/monitor.env \
#     /opt/workfolio/current/deploy/scripts/monitor.sh --test-alert [teams|ntfy|all]
#
# 1. Microsoft Teams (primary, operational channel): the URL of a Workflows flow made from the template
#    "Post to a channel when a webhook request is received" (channel > ... > Workflows). The monitor posts an
#    Adaptive Card. MIN_LEVEL WARN = every event (default); FAIL = critical events only.
#ALERT_TEAMS_WEBHOOK_URL=https://REPLACE.environment.api.powerplatform.com/powerautomate/automations/direct/workflows/REPLACE
ALERT_TEAMS_MIN_LEVEL=WARN
# 2. ntfy (secondary, phone push): the full topic URL; the random topic name is the secret. MIN_LEVEL FAIL =
#    critical events only (a FAIL verdict, its repeats and the recovery from it), so routine warnings are not
#    duplicated to the phone; WARN = every event.
#ALERT_NTFY_URL=https://ntfy.sh/REPLACE_WITH_RANDOM_TOPIC
ALERT_NTFY_MIN_LEVEL=FAIL
# 3. Generic: a webhook that accepts JSON {"text": "..."} (Slack, ...), and/or any command run as
#    `bash -c "$ALERT_CMD" alert <title> <body-file>`. Both receive every event. Put a command value in single
#    quotes: systemd removes unquoted inner double quotes from EnvironmentFile values.
#ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE
#ALERT_CMD='mail -s "$1" ops@example.com < "$2"'
ALERT_REPEAT_MINUTES=360

# FAIL when the newest local backup is older than this (nightly at 02:30 UTC + build time: 30 h is one miss).
BACKUP_MAX_AGE_HOURS=30
# Warn when the filesystem holding /var/lib/workfolio is fuller than this; FAIL at 95 % (healthcheck.sh).
DISK_WARN_PERCENT=80
# Warn when the timelapse scratch directory holds more than this (MB): encodes are not being cleaned up.
TIMELAPSE_SCRATCH_WARN_MB=1024
# How far back the API journal is scanned for storage (OneDrive) failures on each run (minutes).
LOG_WINDOW_MINUTES=6
# 1 while OneDrive is intentionally not connected (first launch): /ready 503 with the database up is expected
# and does not warn. Remove (or set 0) as soon as OneDrive is connected, so a lost connection warns again.
#STORAGE_EXPECTED_DOWN=1
