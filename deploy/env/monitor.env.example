# Settings for workfolio-monitor.timer (deploy/scripts/monitor.sh, every 5 minutes as workfolio).
# Copy to /etc/workfolio/monitor.env, owner root:workfolio, mode 0640. Everything is optional: without an
# alert destination the monitor only logs (journalctl -t workfolio-monitor) and keeps its state file.

# Where alerts go. Either or both. Sent on every change of state (OK -> WARN/FAIL, back to OK) and repeated
# every ALERT_REPEAT_MINUTES while a FAIL persists; never on every run.
# 1. A webhook that accepts JSON {"text": "..."} (Microsoft Teams incoming webhook / Workflows, Slack, Discord
#    via its /slack endpoint, ntfy.sh, ...). The URL is a secret: keep this file 0640.
#ALERT_WEBHOOK_URL=https://example.webhook.office.com/webhookb2/REPLACE
# 2. Any command, run as `bash -c "$ALERT_CMD" alert <subject> <body-file>` ($1 = subject, $2 = path of a
#    file holding the details), e.g. local mail or a curl to another service.
#ALERT_CMD=mail -s "$1" ops@example.com < "$2"
ALERT_REPEAT_MINUTES=360

# FAIL when the newest local backup is older than this (nightly at 02:30 UTC + build time: 30 h is one miss).
BACKUP_MAX_AGE_HOURS=30
# Warn when the filesystem holding /var/lib/workfolio is fuller than this; FAIL at 95 % (healthcheck.sh).
DISK_WARN_PERCENT=80
# Warn when the timelapse scratch directory holds more than this (MB): encodes are not being cleaned up.
TIMELAPSE_SCRATCH_WARN_MB=1024
# How far back the API journal is scanned for storage (OneDrive) failures on each run (minutes).
LOG_WINDOW_MINUTES=6
