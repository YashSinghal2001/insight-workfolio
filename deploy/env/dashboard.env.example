# Insight Workfolio dashboard, production on the Hostinger VPS.
# Copy to /etc/workfolio/dashboard.env, owner root:workfolio, mode 0640. No secrets live here.
NODE_ENV=production
# Baked into the bundle by `next build` (deploy/scripts/deploy.sh reads it from this file). Must be https.
NEXT_PUBLIC_API_URL=https://api.example.com
# Listen address and port are fixed in workfolio-dashboard.service (127.0.0.1:3000); Caddy proxies app.<domain> to it.
