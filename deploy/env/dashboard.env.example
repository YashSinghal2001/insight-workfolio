# Insight Workfolio dashboard, production on the Hostinger VPS.
# Copy to /etc/workfolio/dashboard.env, owner root:workfolio, mode 0640. No secrets live here.
NODE_ENV=production
# Baked into the bundle by `next build` (deploy/scripts/deploy.sh reads it from this file). Must be https.
# Temporary single-origin launch on the public IP (deploy/caddy/Caddyfile.ip): the API is reached on the
# same origin under /api, so set the origin itself: NEXT_PUBLIC_API_URL=https://189.72.144.117
NEXT_PUBLIC_API_URL=https://api.example.com
# Listen address and port are fixed in workfolio-dashboard.service (127.0.0.1:3000); Caddy proxies app.<domain>
# (or /* of the single origin) to it.
