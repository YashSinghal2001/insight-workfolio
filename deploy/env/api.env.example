# Insight Workfolio API, production on the Hostinger VPS.
# Copy to /etc/workfolio/api.env, owner root:workfolio, mode 0640. NEVER commit a filled-in copy.
# Format: KEY=value, one per line, no `export`, no quotes needed (systemd EnvironmentFile and
# `node --env-file` both read it). Every value is validated at boot (apps/api/src/config/env.ts); the API
# refuses to start on an insecure or incomplete configuration and names the variable, never the value.

NODE_ENV=production
# Loopback only: Caddy is the public entry (deploy/caddy/Caddyfile proxies to 127.0.0.1:4000).
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Caddy runs on this host, so X-Forwarded-For is trusted from loopback only (the default).
TRUST_PROXY=loopback
# Requests per minute per session (default 600 in production); leave empty for the default.
API_RATE_LIMIT_PER_MINUTE=

# Browser origins allowed to call the API: the dashboard plus the desktop app's webview origins. https only.
CORS_ORIGINS=https://app.example.com,tauri://localhost,http://tauri.localhost
# Used for password-setup links printed by admin:create.
DASHBOARD_URL=https://app.example.com

# Persistent local SQLite/libSQL file (absolute path, outside the repository, owner workfolio 0600).
# The API never migrates it at boot: `deploy/scripts/deploy.sh --migrate` (after a backup) or
# `node --env-file=/etc/workfolio/api.env dist/cli/migrate.js` applies migrations and sets WAL mode.
DATABASE_URL=file:/var/lib/workfolio/db/workfolio.db
DATABASE_AUTH_TOKEN=

# HMAC key for access tokens, at least 32 characters. Generate on the VPS:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_48_RANDOM_BYTES_BASE64URL

# Screenshots and timelapse videos: the IT storage account's OneDrive through Microsoft Graph
# (delegated Files.ReadWrite only; docs/onedrive.md). Nothing is stored permanently on this VPS.
SCREENSHOT_STORAGE=onedrive
ONEDRIVE_TENANT_ID=REPLACE_ENTRA_TENANT_ID
ONEDRIVE_CLIENT_ID=REPLACE_APP_REGISTRATION_CLIENT_ID
ONEDRIVE_CLIENT_SECRET=REPLACE_CLIENT_SECRET
# Must equal the redirect URI registered in Entra, exactly.
ONEDRIVE_REDIRECT_URI=https://api.example.com/api/v1/storage/onedrive/oauth/callback
# Encrypted refresh-token file, written by the connect flow (0600). Directory is 0700 workfolio.
ONEDRIVE_TOKEN_FILE=/var/lib/workfolio/secrets/onedrive.json
# 32 random bytes, base64: openssl rand -base64 32   (changing it means reconnecting OneDrive)
ONEDRIVE_TOKEN_KEY=REPLACE_WITH_openssl_rand_base64_32
# The only account allowed to connect.
ONEDRIVE_ACCOUNT_EMAIL=it@example.com
ONEDRIVE_ROOT_FOLDER=InsightWorkfolio
# false = deleted files go to the OneDrive recycle bin (recoverable for a while); true = gone at once.
GRAPH_PERMANENT_DELETE=false
# Off-site database backups (deploy/README.md "Backups"): a dedicated subfolder of ONEDRIVE_ROOT_FOLDER,
# written by dist/cli/backup-upload.js from workfolio-backup.service; never the screenshot/timelapse folders.
ONEDRIVE_BACKUP_FOLDER=db-backups
# Uncomment to move off-site backups older than this many days to the OneDrive recycle bin after each
# upload. Unset: the uploader never deletes anything.
#ONEDRIVE_BACKUP_KEEP_DAYS=90

# Timelapse encoder (apt package ffmpeg, built with libx264) and its scratch directory (0700, files are
# deleted right after the upload to OneDrive; tmpfiles.d removes anything older than 2 days).
FFMPEG_PATH=/usr/bin/ffmpeg
TIMELAPSE_DIR=/var/lib/workfolio/tmp/timelapses
# Hours a finished video stays in OneDrive before it is deleted (it can be made again).
TIMELAPSE_TTL_HOURS=24
# Videos are refused (not queued, not encoded) while the TIMELAPSE_DIR filesystem has less than this free,
# so an encode can never fill the disk the database lives on. 0 disables the guard.
TIMELAPSE_MIN_FREE_MB=2048

# No email provider is integrated yet.
REPORT_MAIL_PROVIDER=none
REPORT_SCHEDULER_SECONDS=300

# Website tracking stays off until HR/Legal approve the policy (docs/website-usage.md).
WEBSITE_TRACKING_APPROVED=false
WEBSITE_RETENTION_APPROVED=false
