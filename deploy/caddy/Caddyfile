# Insight Workfolio reverse proxy. Installed at /etc/caddy/Caddyfile. WORKFOLIO_DOMAIN and ACME_EMAIL come
# from /etc/caddy/workfolio.env through the systemd drop-in deploy/caddy/caddy-override.conf.
#
# Caddy terminates TLS (Let's Encrypt, automatic issue and renewal) and is the only public listener
# (80 -> 443 redirect, 443). The apps listen on loopback only and are reached here by 127.0.0.1 address.
# Caddy sets X-Forwarded-For / X-Forwarded-Proto on every proxied request; the API trusts them from
# loopback only (TRUST_PROXY=loopback). Security headers (HSTS, nosniff, frame denial, no-store,
# referrer policy) are set by the apps themselves, not duplicated here.
{
	email {$ACME_EMAIL}
	# Admin API off: nothing on this host needs to reconfigure Caddy at runtime.
	admin off
}

app.{$WORKFOLIO_DOMAIN} {
	# Desktop installers hosted on the VPS (see Caddyfile.ip): top-level .exe/.dmg and desktop-releases.json in /srv/workfolio-downloads only.
	handle_path /desktop-downloads/* {
		root * /srv/workfolio-downloads
		@installer path_regexp ^/(test/)?[A-Za-z0-9][A-Za-z0-9._-]*\.(exe|dmg|sig|tar\.gz)$
		handle @installer {
			header Content-Disposition attachment
			header X-Content-Type-Options nosniff
			header Cache-Control no-cache
			file_server
		}
		# Runtime release manifest the dashboard reads (written atomically by the publisher receiver).
		@manifest path /desktop-releases.json /test/desktop-releases.json
		handle @manifest {
			header X-Content-Type-Options nosniff
			header Cache-Control no-cache
			file_server
		}
		handle {
			respond 404
		}
	}
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:3000
	}
	log {
		output file /var/log/caddy/app.access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

api.{$WORKFOLIO_DOMAIN} {
	# Screenshot uploads are raw WebP up to 10 MB; JSON bodies are capped at 1 MB by the API.
	request_body {
		max_size 12MB
	}
	# Timelapse downloads can take a while over slow links; the API bounds each stream itself.
	reverse_proxy 127.0.0.1:4000 {
		transport http {
			response_header_timeout 60s
		}
		flush_interval -1
	}
	log {
		output file /var/log/caddy/api.access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
