# Copy to /etc/caddy/workfolio.env (root:caddy, 0640). Not secret, but keep it out of the repository anyway.
# install-vps.sh picks the Caddyfile from these two values:
#   WORKFOLIO_DOMAIN set (not example.com)  -> deploy/caddy/Caddyfile:    https://app.<domain> + https://api.<domain>
#   WORKFOLIO_PUBLIC_IP set, no domain      -> deploy/caddy/Caddyfile.ip: https://<ip>, /api/* -> API, rest -> dashboard
#                                              (temporary launch without a domain; Let's Encrypt short-lived IP certificate)
#   neither                                 -> Caddy left untouched (no public site)
# Parent domain: the dashboard is app.<domain>, the API api.<domain> (same site, so the API's
# SameSite=Strict session cookies flow between them). Leave as example.com while there is no domain.
WORKFOLIO_DOMAIN=example.com
# The VPS public IPv4 address, for the single-origin variant. Leave empty once a domain is used.
WORKFOLIO_PUBLIC_IP=189.72.144.117
# Let's Encrypt account / expiry notices.
ACME_EMAIL=it@example.com
